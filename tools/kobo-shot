#!/bin/sh
# Grab a screenshot of the Kobo: runs `koboterm shot` on the device, pulls the
# half-size PGM over the ssh tty and converts it to PNG next to this repo.
# usage: tools/kobo-shot [out.png]
set -eu
OUT="${1:-shot.png}"
HERE="$(cd "$(dirname "$0")" && pwd)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
printf '/mnt/onboard/.adds/koboterm/koboterm shot /tmp/shot.pgm >/dev/null 2>&1; base64 /tmp/shot.pgm\n' | "$HERE/kobo-sh" | grep -E '^[A-Za-z0-9+/=]+$' > "$TMP/shot.b64"
base64 -d < "$TMP/shot.b64" > "$TMP/shot.pgm"
python3 - "$TMP/shot.pgm" "$OUT" <<'PY'
import sys, zlib, struct
src, out = sys.argv[1], sys.argv[2]
data = open(src, 'rb').read()
parts = data.split(b'\n', 3)
w, h = map(int, parts[1].split()); px = parts[3]
raw = b''.join(b'\x00' + px[y*w:(y+1)*w] for y in range(h))
def chunk(t, d): return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
png = b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 0, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b'')
open(out, 'wb').write(png)
print(f"{out}: {w}x{h}")
PY
